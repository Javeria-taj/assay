# Assay — environment.
#
# Copy to .env.local for local work. .env.local is gitignored and must stay
# that way: it is the only place a key is ever written.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------- apps/api

# Where cycles come from.
#   synthetic  the generator (default, and what the demo runs on)
#   live       a real rail, read-only, test mode — requires the two keys below
# Asking for `live` without keys is a startup failure, never a silent fallback.
ASSAY_SOURCE=synthetic

# Seed for the synthetic generator, so a demo reproduces exactly. Batch 3.
ASSAY_SEED=4217

# The single browser origin the API answers, no trailing slash.
# http://localhost:3000 is allowed automatically when NODE_ENV is not production.
ALLOWED_ORIGIN=http://localhost:3000

# Port. Render sets this itself; locally it defaults to 4318.
# PORT=4318

# Razorpay test-mode keys. Read-only use only — Assay issues no write calls.
# Required only when ASSAY_SOURCE=live. Never commit these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Guards the ops endpoints. Render generates this one.
# OPS_TOKEN=

# For the policy parser: the model reads and writes English, and never touches
# a rupee. Not required to run the API.
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- apps/web

# The API's base URL. Inlined at BUILD time by Next, so changing it needs a
# rebuild, not just a restart.
NEXT_PUBLIC_ASSAY_API=http://localhost:4318
