{
  "name": "assay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Assay tells you what your settlement is actually made of.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "mock": "node tools/mock-server.mjs",
    "verify": "tsx tools/verify-contract.ts",
    "verify:mock": "node tools/with-mock.mjs tsx tools/verify-contract.ts",
    "test": "pnpm --filter @assay/contract test",
    "test:golden": "tsx --test apps/api/src/engine/golden.test.ts",
    "typecheck": "tsc --pretty false",
    "build": "pnpm --filter @assay/web build",
    "fixtures:build": "tsx tools/build-fixtures.ts",
    "fixtures:check": "tsx tools/build-fixtures.ts && git diff --exit-code -- tools/fixtures.generated.json",
    "spike:razorpay": "tsx scripts/spike-razorpay.mts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
